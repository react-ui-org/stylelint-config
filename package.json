{
  "name": "@react-ui-org/stylelint-config",
  "description": "Shareable Stylelint config for CSS, SCSS and CSS Modules projects.",
  "version": "1.0.0",
  "keywords": [
    "stylelint",
    "stylelint-config",
    "config",
    "css",
    "scss",
    "css-modules",
    "styleguide",
    "react-ui"
  ],
  "homepage": "https://github.com/react-ui-org/stylelint-config",
  "author": "The React UI Authors (https://github.com/react-ui-org/stylelint-config/graphs/contributors)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/react-ui-org/stylelint-config/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/configs/base.mjs",
    "./scss": "./src/configs/scss.mjs",
    "./cssModules": "./src/configs/cssModules.mjs",
    "./helpers": "./src/helpers/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/react-ui-org/stylelint-config"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.23.0 || ^24.20.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.19.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "inspect": "stylelint --config inspect.config.mjs --print-config",
    "lint": "npm run eslint && npm run markdownlint",
    "markdownlint": "markdownlint-cli2 \"README.md\" \"src/**/*.md\"",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "@stylistic/stylelint-config": "^5.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1"
  },
  "peerDependencies": {
    "stylelint": "^17.6.0"
  },
  "devDependencies": {
    "@react-ui-org/eslint-config": "^1.1.0",
    "eslint": "^9.39.5",
    "markdownlint-cli2": "^0.23.2",
    "stylelint": "^17.15.0"
  }
}
